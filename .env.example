# Grafana Cloud - copy to .env and fill in. .env is gitignored; never commit it.
GRAFANA_URL=https://politebamboo549.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# OTLP (from the OpenTelemetry tile -> Configure)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSTANCE_ID=
OTEL_EXPORTER_OTLP_TOKEN=
# NOTE: the Python SDK needs Basic%20 (percent-encoded space), not "Basic ".
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance_id:token>
